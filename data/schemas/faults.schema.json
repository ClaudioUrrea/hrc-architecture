{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault campaign events",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "event_id",
      "category",
      "t_hours",
      "detection_ms",
      "service_affecting"
    ],
    "properties": {
      "event_id": {
        "type": "integer"
      },
      "category": {
        "enum": [
          "tracking_loss",
          "sensor_timeout",
          "computational_overrun",
          "hardware_communication",
          "configuration_inconsistency",
          "network_partition",
          "constraint_violation",
          "memory_allocation"
        ]
      },
      "t_hours": {
        "type": "number",
        "minimum": 0,
        "maximum": 200
      },
      "detection_ms": {
        "type": "number",
        "minimum": 0,
        "description": "Detection latency, ms (re-derived in v2.1.0 by tools/reconstruct_faults.py)"
      },
      "recovery_s": {
        "type": [
          "number",
          "null"
        ],
        "description": "Recovery time of an automatically recovered event, s (re-derived in v2.1.0)"
      },
      "service_affecting": {
        "enum": [
          "yes",
          "no"
        ]
      },
      "operator_intervention": {
        "enum": [
          "yes",
          "no"
        ]
      },
      "intervention_min": {
        "type": [
          "number",
          "null"
        ],
        "description": "Operator time to resume after the event, minutes (operator-intervention events only)"
      }
    }
  }
}