{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "protocol",
  "description": "Protocol transactions. Column schema for protocol_samples.parquet, deposit v2.1.0. RECONSTRUCTED data, not instrument recordings (docs/DATA_PROVENANCE.md).",
  "type": "object",
  "properties": {
    "sample_id": {
      "description": "int64"
    },
    "protocol": {
      "description": "string"
    },
    "operation": {
      "description": "string"
    },
    "t_s": {
      "description": "double"
    },
    "value": {
      "description": "double"
    },
    "unit": {
      "description": "string"
    },
    "load_rpm": {
      "description": "double"
    },
    "node": {
      "description": "int16"
    }
  }
}
